{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicecap.shop/schemas/contracts/v1/request.json",
  "title": "VoiceCAP Sales API Request Schema",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "get-bootstrap",
        "update-settings",
        "list-devices",
        "update-device-capabilities",
        "set-output-device",
        "start-session",
        "end-session",
        "prepare-product",
        "update-product-draft",
        "commit-product",
        "activate-product",
        "ingest-comments",
        "get-sales-feed",
        "list-live-comments",
        "delete-live-comments",
        "search-buyers",
        "confirm-buyer",
        "commit-sales",
        "get-operation",
        "list-session-products",
        "get-product-sales",
        "prepare-product-image",
        "preview-product-change",
        "commit-product-change",
        "request-reprint",
        "get-print-status",
        "claim-print-jobs",
        "renew-print-lease",
        "begin-print-job",
        "acknowledge-print-job"
      ]
    },
    "operationId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "productId": { "type": "string", "format": "uuid" },
    "draftId": { "type": "string", "format": "uuid" },
    "deviceId": { "type": "string", "format": "uuid" },
    "jobId": { "type": "string", "format": "uuid" },
    "leaseToken": { "type": "string" },
    "previewToken": { "type": "string" },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "expectedSessionRevision": { "type": "integer", "minimum": 0 },
    "expectedProductRevision": { "type": "integer", "minimum": 0 },
    "expectedSalesRevision": { "type": "integer", "minimum": 0 },
    "expectedDraftRevision": { "type": "integer", "minimum": 0 },
    "expectedDeviceRevision": { "type": "integer", "minimum": 0 },
    "expectedSaleRevision": { "type": "integer", "minimum": 0 },
    "expectedSettingsRevision": { "type": "integer", "minimum": 0 }
  }
}
