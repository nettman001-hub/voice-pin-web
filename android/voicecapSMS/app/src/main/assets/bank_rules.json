      "exclude": ["출금", "승인", "취소", "예정", "결제"],
      "patterns": [
        "입금\\s*(?<amount>[0-9][0-9,]*)원\\s+[0-9]{2}/[0-9]{2}\\s+[0-9]{2}:[0-9]{2}\\s+(?<receiverFrom>[0-9][0-9*\\-]{3,}[0-9*])\\s+(?<payer>.+?)\\s+잔액\\s*(?<balance>[0-9][0-9,]*)원"
      ],
      "verified": false
    }
  ],
