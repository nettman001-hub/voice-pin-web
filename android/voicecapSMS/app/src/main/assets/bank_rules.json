{
  "version": 1,
  "note": "모든 규칙은 은행이 보내는 입출금 SMS 형식을 바탕으로 만든 추정이며 실제 앱 알림으로 확인하지 않았다(verified:false). 샘플 수집 모드로 실제 알림을 모은 뒤 고치고 verified:true로 바꾼다. 제외 키워드는 은행 규칙 안에만 두고, 잔액·이체는 전역 제외하지 않는다. 범용 폴백 규칙은 두지 않는다.",
  "rules": [
    {
      "package": "com.kbstar.kbbank",
      "bank": "KB국민은행",
      "senders": [],
      "require": ["입금"],
      "exclude": ["출금", "승인", "취소", "예정", "체크카드", "결제"],
      "patterns": [
        "(?<receiverFrom>[0-9][0-9*]{3,}[0-9*])\\s*\\n(?<payer>[^\\n]+)\\n입금\\n(?<amount>[0-9][0-9,]*)\\n잔액\\s*(?<balance>[0-9][0-9,]*)",
        "(?<payer>[^\\n]+)\\n입금\\n(?<amount>[0-9][0-9,]*)\\n잔액\\s*(?<balance>[0-9][0-9,]*)"
      ],
      "verified": false
    },
    {
      "package": "com.shinhan.sbanking",
      "bank": "신한은행",
      "senders": [],
      "require": ["입금", "잔액"],
      "exclude": ["출금", "승인", "취소", "예정", "결제"],
      "patterns": [
        "(?<receiverFrom>[0-9][0-9*\\-]{3,}[0-9*])\\s*\\n\\s*입금\\s+(?<amount>[0-9][0-9,]*)\\s*\\n\\s*잔액\\s+(?<balance>[0-9][0-9,]*)\\s*\\n\\s*(?<payer>[^\\n]+)",
        "입금\\s+(?<amount>[0-9][0-9,]*)\\s*\\n\\s*잔액\\s+(?<balance>[0-9][0-9,]*)\\s*\\n\\s*(?<payer>[^\\n]+)"
      ],
      "verified": false
    },
    {
      "package": "nh.smart.banking",
      "bank": "NH농협은행",
      "senders": [],
      "require": ["입금"],
      "exclude": ["출금", "승인", "취소", "예정", "결제"],
      "patterns": [
        "입금\\s*(?<amount>[0-9][0-9,]*)원\\s+[0-9]{2}/[0-9]{2}\\s+[0-9]{2}:[0-9]{2}\\s+(?<receiverFrom>[0-9][0-9*\\-]{3,}[0-9*])\\s+(?<payer>.+?)\\s+잔액\\s*(?<balance>[0-9][0-9,]*)원"
      ],
      "verified": false
    }
  ]
}
