# 로컬 수집 서버 설정 예시 (.env 파일로 복사해서 사용)
PORT=2137
HOST=127.0.0.1

# Euler Stream API 키 (https://www.eulerstream.com 무료 가입 후 발급)
# 미설정 시 상위 폴더의 eulerstream_key.txt 또는 이 폴더의 eulerstream_key.txt를 자동으로 읽는다.
EULERSTREAM_API_KEY=

# 웹앱에서 접속 허용할 오리진 (쉼표 구분)
ALLOWED_ORIGINS=https://voicecap.shop,https://www.voicecap.shop,https://voice-pin-web.vercel.app,http://localhost:5173,http://localhost:3000

# Android voicecapSMS 앱에서 이 PC로 접근하려면 HOST=0.0.0.0 으로 바꾼다.
# 같은 Wi-Fi의 다른 기기에서 접근할 때는 반드시 충분히 긴 API 키를 설정한다.
SMS_BRIDGE_API_KEY=change-this-to-a-long-random-key
SMS_BRIDGE_DATA_FILE=./data/bridge.json
